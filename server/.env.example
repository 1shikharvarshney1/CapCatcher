# =====================================================================
# CapCatcher Server Configuration Template
# Copy this file to `server/.env` and supply your actual API credentials.
# =====================================================================

# Server network port (Optional, default: 5001)
PORT=5001

# Whisper Audio Transcription Provider (Optional, default: local)
# Options:
#   local - Runs open-source Whisper locally via Python worker (faster-whisper/PyTorch CPU).
#           Recommended for local development, offline evaluations, and privacy. Requires Python 3.10+.
#   groq  - Calls Groq's cloud-hosted Whisper-large-v3 API (<1s latency, minimal RAM).
#           Required for free-tier cloud deployment (Render 512MB RAM limit).
WHISPER_PROVIDER=local

# Local Whisper Configuration (Only used when WHISPER_PROVIDER=local)
# Model size options: tiny, base, small, medium, large-v3 (default: base)
WHISPER_LOCAL_MODEL=base
# Compute precision for faster-whisper (default: int8)
WHISPER_COMPUTE_TYPE=int8

# Groq API Key (Required when WHISPER_PROVIDER=groq, or for cloud deployments)
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Required for claim extraction and claim verification)
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Variant (Optional, default: gemini-3.5-flash-lite)
# Options include: gemini-3.5-flash-lite, gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite

# Tavily Search API Key (Required for web evidence retrieval)
# Get your free API key at: https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Google Fact Check Tools API Key (Optional supplemental fact-checking endpoint)
# Get your key at: https://console.cloud.google.com/apis/credentials
GOOGLE_FACTCHECK_API_KEY=your_google_factcheck_api_key_here

# MongoDB Connection String (Optional)
# If omitted, CapCatcher automatically starts a local in-memory MongoDB instance (no setup needed).
# Example format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=
