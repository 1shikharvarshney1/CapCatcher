# =====================================================================
# CapCatcher Server Configuration Template
# Copy this file to `server/.env` and supply your actual API credentials.
# =====================================================================

# Server network port (Optional, default: 5001)
PORT=5001

# Groq API Key (Required for audio speech-to-text transcription via Whisper)
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Required for claim extraction and claim verification)
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Variant (Optional, default: gemini-1.5-flash)
# Options include: gemini-1.5-flash, gemini-3.1-flash-lite
GEMINI_MODEL=gemini-1.5-flash

# Tavily Search API Key (Required for web evidence retrieval)
# Get your free API key at: https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Google Fact Check Tools API Key (Optional supplemental fact-checking endpoint)
# Get your key at: https://console.cloud.google.com/apis/credentials
GOOGLE_FACTCHECK_API_KEY=your_google_factcheck_api_key_here

# MongoDB Connection String (Optional)
# If omitted, CapCatcher automatically starts a local in-memory MongoDB instance (no setup needed).
# Example format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=
